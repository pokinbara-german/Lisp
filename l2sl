;Parses text into lists of words.

(defun l2lofl (lambda (x)
         (cond ((null x) nil)               
               ((equal | | (car x)) (list (l2lofl (cdr x))) )
               (t (cons (car x) (l2lofl (cdr x))) )
         )
))

(defun Main1 (lambda (lst)
        (cond ((null lst) nil)
              ((null (cdr lst)) lst)
              ((eq | | (car lst)) (main1 (cdr lst)) )
              (t  (spec (reverse (l2lofl (no2space lst)))) )
        )
))
                                          
;Flattens nested lists into a list of words.
(defun spec (lambda (lst)
         (cond ((null lst) nil)
               ((atom (car lst)) (list (pack (reverse lst))) )
               (t (cons (pack (reverse (cdr lst))) (spec (reverse (car lst)))) )
         )
))

;Removes duplicate spaces and trailing spaces.
(defun no2space (lambda (lst)
         (cond ((null (cdr lst)) (cond ((not (equal | | (car lst))) (list (car lst)))
                                       (t '()) ) )
               ((and (equal (car lst) (cadr lst)) 
                     (equal | | (car lst)) ) (no2space (cdr lst)))
               (t (cons (car lst) (no2space (cdr lst))) )
         )
))

(defun main (lambda (x)
         (main1 (unpack x))
))

